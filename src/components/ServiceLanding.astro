---
import Layout from '@/layouts/Layout.astro'
import ServiceCard from '@/components/ServiceCard.svelte'
import ContactFormTrigger from '@/components/ContactFormTrigger.svelte'
import type { ServiceLanguage } from '@/data/services'

interface Props {
  lang: ServiceLanguage
  service: {
    title: string
    description: string
    intro: string
    sections: { title: string; content: string }[]
  }
  relatedServices: { slug: string; icon: string; title: string }[]
}

const { lang, service, relatedServices } = Astro.props
const homeUrl = lang === 'ca' ? '/ca/' : '/'
const contactLabel = lang === 'ca' ? 'Explica’ns què necessites' : 'Cuéntanos qué necesitas'
const relatedTitle = lang === 'ca' ? 'Altres serveis' : 'Otros servicios'
const servicesLabel = lang === 'ca' ? 'Serveis per a empreses' : 'Servicios para empresas'
const relatedHeading = lang === 'ca' ? 'També et pot interessar' : 'También te puede interesar'
---

<Layout
  title={`Grup de Suport | ${service.title}`}
  description={service.description}
  service={{ name: service.title, description: service.description }}
>
  <main class="service-page g-wrapper">
    <nav aria-label={lang === 'ca' ? 'Fil d’Ariadna' : 'Ruta de navegación'} class="breadcrumb">
      <a href={homeUrl}>{lang === 'ca' ? 'Inici' : 'Inicio'}</a>
      <span aria-hidden="true">›</span>
      <a href={`${homeUrl}#servicios`}>{lang === 'ca' ? 'Serveis' : 'Servicios'}</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{service.title}</span>
    </nav>

    <header class="service-hero">
      <div class="hero-copy">
        <span class="eyebrow">
          <span class="eyebrow-mark" aria-hidden="true"></span>
          {servicesLabel}
        </span>
        <h1>{service.title}</h1>
        <p class="intro">{service.intro}</p>
        <ContactFormTrigger
          lang={lang}
          label={contactLabel}
          customClass="service-cta"
          client:load
        />
      </div>
      <div class="hero-decoration" aria-hidden="true">
        <span class="decoration-orbit orbit-one"></span>
        <span class="decoration-orbit orbit-two"></span>
        <span class="decoration-dot"></span>
      </div>
    </header>

    <article class="service-content">
      {
        service.sections.map((section) => (
          <section class="service-section">
            <span class="section-mark" aria-hidden="true" />
            <div>
              <h2>{section.title}</h2>
              <p>{section.content}</p>
            </div>
          </section>
        ))
      }
    </article>

    <nav class="related-services" aria-label={relatedTitle}>
      <div class="related-heading">
        <span class="eyebrow">{relatedTitle}</span>
        <h2>{relatedHeading}</h2>
      </div>
      <ul class="related-list">
        {
          relatedServices.map((relatedService) => (
            <li>
              <ServiceCard
                icon={relatedService.icon}
                title={relatedService.title}
                href={`${lang === 'ca' ? '/ca' : ''}/servicios/${relatedService.slug}/`}
                linkLabel={lang === 'ca' ? 'Més informació' : 'Saber más'}
              />
            </li>
          ))
        }
      </ul>
    </nav>
  </main>
</Layout>

<style lang="scss">
  .service-page {
    max-width: 1120px;
    padding-top: 105px;
    padding-bottom: 100px;
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
    color: var(--colorText2);
    font-size: 13px;

    a {
      color: var(--colorText2);
      text-decoration: none;

      &:hover {
        color: var(--colorPrimary);
      }
    }

    [aria-current='page'] {
      color: var(--colorText);
    }
  }

  .service-hero {
    position: relative;
    display: flex;
    min-height: 340px;
    align-items: center;
    overflow: hidden;
    padding: clamp(30px, 7vw, 76px);
    border-radius: 28px;
    background: radial-gradient(ellipse at 88% 25%, rgba(255, 255, 255, 0.2), transparent 33%),
      linear-gradient(120deg, var(--colorPrimary), #1774b1);
    color: white;
    isolation: isolate;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    max-width: 720px;

    h1 {
      max-width: 680px;
      margin: 22px 0 16px;
      font-family: var(--fontPrimary);
      font-size: clamp(38px, 6vw, 64px);
      line-height: 1.08;
      text-wrap: balance;
    }
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .eyebrow-mark {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #c4db69;
  }

  .intro {
    max-width: 660px;
    margin: 0;
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.7;
  }

  .hero-decoration {
    position: absolute;
    z-index: 0;
    top: 50%;
    right: 7%;
    width: 270px;
    aspect-ratio: 1;
    transform: translateY(-50%);
    opacity: 0.65;
  }

  .decoration-orbit {
    position: absolute;
    inset: 10%;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 50%;

    &.orbit-two {
      inset: 0;
      transform: rotate(-35deg) scaleY(0.48);
    }
  }

  .decoration-dot {
    position: absolute;
    top: 17%;
    right: 13%;
    width: 24px;
    height: 24px;
    border: 5px solid rgba(255, 255, 255, 0.8);
    border-radius: 50%;
    background: #c4db69;
  }

  .service-content {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 50px 0;
  }

  .service-section {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    padding: 30px;
    width: 100%;
    border-radius: var(--radius);
    background-color: var(--colorBackground);
    box-shadow: rgba(151, 65, 252, 0.2) 0 15px 30px -5px;

    h2 {
      margin: 0 0 12px;
      color: var(--colorText);
      font-family: var(--fontPrimary);
      font-size: 22px;
      line-height: 1.3;
    }

    p {
      margin: 0;
      color: var(--colorText2);
      font-size: 16px;
      line-height: 1.75;
    }
  }

  .section-mark {
    flex: 0 0 4px;
    min-height: 52px;
    border-radius: 4px;
    background: linear-gradient(var(--colorPrimary), #c4db69);
  }

  :global(.service-cta) {
    margin-top: 28px;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 999px;
    background: white;
    color: #176b9f;

    &:hover {
      background: white;
      color: #176b9f;
      transform: translateY(-2px);
    }

    &:focus-visible {
      outline: 3px solid white;
      outline-offset: 4px;
    }
  }

  .related-services {
    margin: 72px auto 0;

    .related-heading {
      margin-bottom: 22px;
    }

    .eyebrow {
      color: var(--colorPrimary);
    }

    h2 {
      margin: 8px 0 0;
      color: var(--colorText);
      font-family: var(--fontPrimary);
      font-size: 30px;
    }

    .related-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 14px;
      padding: 0;
      list-style: none;
    }

    li {
      min-width: 0;
    }
  }

  @media (max-width: 760px) {
    .service-page {
      padding-top: 88px;
      padding-bottom: 60px;
    }

    .service-hero {
      min-height: auto;
      padding: 38px 26px;
      border-radius: 22px;
    }

    .hero-decoration {
      top: auto;
      right: -100px;
      bottom: -100px;
      width: 220px;
      transform: none;
      opacity: 0.35;
    }

    .service-content {
      grid-template-columns: 1fr;
      gap: 14px;
      margin-top: 24px;
    }

    .service-section {
      padding: 22px;
    }

    .related-services {
      margin-top: 50px;

      h2 {
        font-size: 26px;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.service-cta) {
      transition: none;
    }
  }
</style>
